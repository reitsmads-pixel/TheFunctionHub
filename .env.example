# Copy these into Netlify: Site configuration → Environment variables. Never commit real values.

# Service account (from the downloaded key file). Scope: Functions only.
GOOGLE_SA_CLIENT_EMAIL=amapi-dashboard@thefunctionhub.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Google Cloud project that owns the enterprise.
GCP_PROJECT_ID=thefunctionhub

# OAuth web client ID for "Sign in with Google" (public; needed at build time and in functions).
GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Comma-separated Google accounts allowed to use the dashboard.
ADMIN_EMAILS=reitsmads@gmail.com

# Set after the one-off enterprise signup on /setup, e.g. enterprises/LC0abc123.
AMAPI_ENTERPRISE=
