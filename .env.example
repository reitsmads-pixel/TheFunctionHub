# ---------------------------------------------------------------------------
# The Function Hub SA — environment variables
#
# Copy this file to `.env` for local development, and paste the same values
# into Netlify under Site settings -> Environment variables.
#
# NOTE: everything prefixed with VITE_ is bundled into the public JavaScript.
# That is normal and safe for Firebase web config — the real protection is
# firestore.rules, not secrecy of these keys.
# ---------------------------------------------------------------------------

# --- Firebase (Project settings -> Your apps -> Web app -> SDK setup) --------
# Leave these blank to run the site in DEMO MODE with built-in sample vendors.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Site ------------------------------------------------------------------
VITE_SITE_URL=https://www.thefunctionhubsa.co.za
VITE_CONTACT_EMAIL=hello@thefunctionhubsa.co.za
VITE_CONTACT_PHONE=+27 00 000 0000
VITE_WHATSAPP=27000000000

# --- Billing (PayFast) -----------------------------------------------------
# Only needed once you switch paid listings on. Sandbox works with the
# published test credentials at https://sandbox.payfast.co.za
VITE_PAYFAST_ENABLED=false

# Server-side only (Netlify env vars — do NOT prefix with VITE_)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=https://www.thefunctionhubsa.co.za/dashboard/billing?status=success
PAYFAST_CANCEL_URL=https://www.thefunctionhubsa.co.za/dashboard/billing?status=cancelled

# Firebase Admin credentials for the PayFast webhook (Project settings ->
# Service accounts -> Generate new private key). Paste the whole JSON on one
# line into the Netlify environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
