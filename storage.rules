rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Listing photos are public — they are shown on public profile pages.
    // Only the owner of the folder may write to it, and only images.
    match /listings/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
